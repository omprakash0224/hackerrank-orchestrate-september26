# .env.example — Template for environment configuration
# Copy to .env and fill in your values. NEVER commit .env to git.

# ── Required ───────────────────────────────────────────────────────────────────
# Your Google Gemini API key (get one at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional (safe defaults shown) ────────────────────────────────────────────
# Gemini model to use for vision OCR, NLP parsing, and explanation synthesis
MODEL_NAME=gemini-1.5-flash

# Path to the dataset directory (relative or absolute)
DATASET_DIR=./dataset

# Maximum async worker threads for parallel request processing
MAX_WORKERS=8

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Path to the OCR cache file (persists between runs to save API tokens)
OCR_CACHE_PATH=./code/evidence/ocr_cache.json

# Fixed random seed for reproducible results
RANDOM_SEED=42
